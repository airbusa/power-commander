/target
# Fetched by vendor/7zip/fetch.sh or fetch.bat.
/vendor/7zip/*/
/vendor/7zip/*.tar.xz
# Fetched by vendor/pdfium/fetch.sh or fetch.bat.
/vendor/pdfium/*/
# Built by vendor/mpv/build.sh (its sources and work in .build), fetched by fetch.bat.
/vendor/mpv/*/
# Built by vendor/rclone/build.sh, with rclone's source in .build.
/vendor/rclone/*/
/vendor/rclone/.build/
# Built by vendor/craft/build.sh, with the Craft tools' source in .build.
/vendor/craft/*/
/vendor/craft/.build/
