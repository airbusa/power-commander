+/// SparkCommander patch: an entry of a drawn menu shown by AppKit, see
+/// `PopupMenu::show_native`.
+pub(crate) enum NativeEntry {
+    Separator,
+    Header(gpui::SharedString),
+    Item {
+        label: gpui::SharedString,
+        disabled: bool,
+        checked: bool,
+        icon: Option<crate::Icon>,
