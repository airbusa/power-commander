+    /// PowerCommander patch: the item's text, and its files as file managers read them.
+    pub(crate) fn set_files(
+        &self,
+        item: &ClipboardItem,
+        selection: ClipboardKind,
+        wait: WaitConfig,
+    ) -> Result<()> {
+        let atoms = &self.inner.atoms;
+        let mut data = vec![ClipboardData {
+            bytes: item.text().unwrap_or_default().into_bytes(),
+            format: atoms.UTF8_STRING,
+        }];
+        for (format, mime_type) in [
+            (atoms.URI_LIST, URI_LIST),
+            (atoms.GNOME_FILES, GNOME_FILES),
+            (atoms.KDE_CUT, KDE_CUT),
+        ] {
+            if let Some(bytes) = file_bytes(item, mime_type) {
+                data.push(ClipboardData { bytes, format });
+            }
+        }
+        self.inner.write(data, selection, wait)
+    }
+
+    /// PowerCommander patch: another program's files, as file managers offer them.
+    pub(crate) fn get_files(&self, selection: ClipboardKind) -> Option<ClipboardItem> {
+        let atoms = &self.inner.atoms;
+        let list = self.inner.read(&[atoms.URI_LIST], selection).ok()?;
+        let mark = |format| {
+            let data = self.inner.read(&[format], selection).ok()?;
+            (data.format == format).then_some(data.bytes)
+        };
+        files_item(&list.bytes, mark(atoms.KDE_CUT), mark(atoms.GNOME_FILES))
+    }
